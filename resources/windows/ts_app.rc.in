// Windows resources for @TS_RC_NAME@.exe (generated by cmake/WinResources.cmake):
// version info, the app icon and the application manifest.
#include <winver.h>
#include <winuser.h>

@TS_RC_ICON_LINE@
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@TS_RC_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "TombStone Team"
      VALUE "FileDescription",  "@TS_RC_DESCRIPTION@"
      VALUE "FileVersion",      "@PROJECT_VERSION@"
      VALUE "InternalName",     "@TS_RC_NAME@"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Brenden Rzuchoveky / TombStone Engine. All rights reserved."
      VALUE "OriginalFilename", "@TS_RC_NAME@.exe"
      VALUE "ProductName",      "TombStone Engine"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
      VALUE "Comments",         "https://github.com/bjrzuchovsky-star/TombStone_Engine"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
