set(TS_FONT_DISPLAY_TTF "${ts_font_rye_SOURCE_DIR}/Rye-Regular.ttf")
set(TS_FONT_BODY_TTF "${ts_font_arvo_SOURCE_DIR}/Arvo-Regular.ttf")

# Write `in` as a C++ byte array `sym` (+ `sym`_size) into `out`. Only
# regenerated when the input is newer.
function(ts_embed_binary in out sym)
  if(EXISTS "${out}" AND NOT "${in}" IS_NEWER_THAN "${out}")
    return()
  endif()
  file(READ "${in}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR n "${n} / 2")
  # 32 bytes per line, then 0xNN, per byte.
  string(REGEX REPLACE "(................................................................)" "\\1\n" hex "${hex}")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  file(WRITE "${out}"
    "// Generated by cmake/FetchFonts.cmake from ${in}. Do not edit.\n"
    "#include <cstddef>\n"
    "extern const unsigned char ${sym}[] = {\n${hex}\n};\n"
    "extern const std::size_t ${sym}_size = ${n};\n")
endfunction()
