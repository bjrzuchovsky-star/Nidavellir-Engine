# In-game UI text (ts_ui): stb_truetype (public domain / MIT) plus two
# SIL OFL 1.1 fonts from google/fonts, all pinned and checked by hash. Only
# the files are downloaded; the TTFs are embedded into ts_ui at configure
# time (licenses: assets/fonts/OFL-*.txt).
include(FetchContent)

set(TS_STB_TRUETYPE_COMMIT 2c980bb59875b0d32144a71867fbdebb2f77cd20)
FetchContent_Declare(
  ts_stb_truetype
  URL      https://raw.githubusercontent.com/nothings/stb/${TS_STB_TRUETYPE_COMMIT}/stb_truetype.h
  URL_HASH SHA256=ecd30b05e0dd4fea3a13c26810dd9e1992dc379049482c393d5a19e6b5090aab
  DOWNLOAD_NO_EXTRACT TRUE
)

set(TS_GOOGLE_FONTS_COMMIT 66928797f271fed5ee428544e7229685e2d90127)
# Display face: Rye (Sorkin Type, OFL) -- wood-type western poster letters.
FetchContent_Declare(
  ts_font_rye
  URL      https://raw.githubusercontent.com/google/fonts/${TS_GOOGLE_FONTS_COMMIT}/ofl/rye/Rye-Regular.ttf
  URL_HASH SHA256=b7edee5e615ae1b6b07e9d030c1309152bf3672a0e8a2a46293e273730f5adba
  DOWNLOAD_NO_EXTRACT TRUE
)
# Body face: Arvo (Anton Koovit, OFL) -- a sturdy, readable slab serif.
FetchContent_Declare(
  ts_font_arvo
  URL      https://raw.githubusercontent.com/google/fonts/${TS_GOOGLE_FONTS_COMMIT}/ofl/arvo/Arvo-Regular.ttf
  URL_HASH SHA256=f41bd41471ec2db7140351bdde614da5341524503598ff7fe79f3c89c13b605e
  DOWNLOAD_NO_EXTRACT TRUE
)
FetchContent_MakeAvailable(ts_stb_truetype ts_font_rye ts_font_arvo)

add_library(ts_stb_truetype INTERFACE)
